<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>mt2_custom_clan_ui_fixes.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <!-- BepInEx.Core trae HarmonyX -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- Las clases del juego (CompendiumSectionChampUpgrades y compania) -->
    <PackageReference Include="MonsterTrain2.Api" Version="4.5.21908879" />
    <!-- Transform, RectTransform, Vector2. UnityEngine.UI NO hace falta: los
         componentes de layout se tocan por reflexion. -->
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Este mod no anade contenido: solo parchea pantallas del juego base, asi que le
       basta con BepInEx, la API del juego y los tipos de Unity. -->
</Project>
